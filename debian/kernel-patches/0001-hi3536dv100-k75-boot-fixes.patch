diff --git a/drivers/phy/hibvt/phy-hisi-sata.c b/drivers/phy/hibvt/phy-hisi-sata.c
--- a/drivers/phy/hibvt/phy-hisi-sata.c
+++ b/drivers/phy/hibvt/phy-hisi-sata.c
@@ -19,6 +19,7 @@
 #include <linux/delay.h>
 #include <linux/io.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/phy/phy.h>
 #include <linux/platform_device.h>
 #include <mach/io.h>
@@ -81,6 +82,19 @@ static int hisi_sata_phy_probe(struct platform_device *pdev)
 	struct resource *res;
 	struct phy *phy;
 	void __iomem *mmio;
+	u32 dt_phy_mode;
+
+	if (!of_property_read_u32(dev->of_node, "hisilicon,phy-mode",
+			&dt_phy_mode)) {
+		if (dt_phy_mode > PHY_MODE_3G) {
+			dev_err(dev, "invalid SATA PHY mode %u\n", dt_phy_mode);
+			return -EINVAL;
+		}
+		phy_mode = dt_phy_mode;
+	}
+
+	dev_info(dev, "SATA PHY mode: %s\n",
+		 phy_mode == PHY_MODE_1_5G ? "1.5Gbps" : "3.0Gbps");
 
 	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
 	if (!res) {
