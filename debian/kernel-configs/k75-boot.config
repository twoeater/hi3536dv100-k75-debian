# Hi3536DV100 K75 boot settings layered over hi3536dv100_full_defconfig.

# Keep ext4 modular.  The initramfs carries these modules, which also made it
# possible to test the root-switch path with the vendor kernel during bring-up.
# CONFIG_EXT3_FS is not set
CONFIG_EXT4_FS=m
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_JBD2=m
CONFIG_FS_MBCACHE=m

# Early output on the K75 PL011 UART.
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_HI3536DV100_UART=y
CONFIG_DEBUG_UART_PHYS=0x12080000
CONFIG_DEBUG_UART_VIRT=0xfe180000
CONFIG_DEBUG_UNCOMPRESS=y
CONFIG_EARLY_PRINTK=y
